{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webg.example/schema/webg-project-physics-v1.json",
  "title": "webg project physics manifest version 1",
  "description": "Physics body and Joint vocabulary used by the WebgSceneApp sample project.",
  "type": "object",
  "additionalProperties": false,
  "required": ["space", "bodies"],
  "properties": {
    "space": { "$ref": "#/$defs/space" },
    "bodies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/body" }
    },
    "joints": {
      "type": "array",
      "maxItems": 8192,
      "items": { "$ref": "#/$defs/distanceJoint" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
    "nonNegative": { "type": "number", "minimum": 0 },
    "unitInterval": { "type": "number", "minimum": 0, "maximum": 1 },
    "vec3": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "positive": { "type": "number", "exclusiveMinimum": 0 },
    "shape": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "size"],
          "properties": {
            "type": { "const": "box" },
            "size": { "$ref": "#/$defs/positiveVec3" },
            "offset": { "$ref": "#/$defs/vec3" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "radius"],
          "properties": {
            "type": { "const": "sphere" },
            "radius": { "$ref": "#/$defs/positive" },
            "offset": { "$ref": "#/$defs/vec3" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "radius", "segmentLength"],
          "properties": {
            "type": { "const": "capsule" },
            "radius": { "$ref": "#/$defs/positive" },
            "segmentLength": { "type": "number", "minimum": 0 },
            "offset": { "$ref": "#/$defs/vec3" }
          }
        }
      ]
    },
    "positiveVec3": {
      "type": "array",
      "prefixItems": [
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 },
        { "type": "number", "exclusiveMinimum": 0 }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normal", "planeDistance"],
      "properties": {
        "normal": { "$ref": "#/$defs/vec3" },
        "planeDistance": { "type": "number" }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minX": { "type": "number" },
        "maxX": { "type": "number" },
        "minZ": { "type": "number" },
        "maxZ": { "type": "number" },
        "floorY": { "type": "number" }
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "referenceLength": { "$ref": "#/$defs/positive" },
        "broadphasePaddingRatio": { "$ref": "#/$defs/positive" },
        "positionSlopRatio": { "$ref": "#/$defs/positive" },
        "supportFeatureToleranceRatio": { "$ref": "#/$defs/positive" },
        "restingRestitutionSpeedRatio": { "$ref": "#/$defs/positive" },
        "sleepLinearSpeedRatio": { "$ref": "#/$defs/positive" },
        "wakeLinearSpeedRatio": { "$ref": "#/$defs/positive" },
        "sleepContactSpeedRatio": { "$ref": "#/$defs/positive" },
        "sleepNormalSpeedRatio": { "$ref": "#/$defs/positive" }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gravity": { "$ref": "#/$defs/vec3" },
        "maxBodies": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "maxJoints": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "maxJointsPerBody": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "jointSolverIterations": { "type": "integer", "minimum": 1, "maximum": 64 },
        "gridSize": { "type": "integer", "minimum": 1, "maximum": 128 },
        "broadphaseMode": { "const": "xzGrid" },
        "fixedTimeStepMs": { "$ref": "#/$defs/positive" },
        "maxSubSteps": { "type": "integer", "minimum": 1, "maximum": 64 },
        "solverIterations": { "type": "integer", "minimum": 1, "maximum": 32 },
        "defaultRestitution": { "$ref": "#/$defs/unitInterval" },
        "defaultFriction": { "$ref": "#/$defs/nonNegative" },
        "maxPlanes": { "type": "integer", "minimum": 1, "maximum": 256 },
        "positionCorrectionBeta": { "$ref": "#/$defs/unitInterval" },
        "persistentSleep": { "type": "boolean" },
        "sleepAngularSpeed": { "$ref": "#/$defs/nonNegative" },
        "wakeAngularSpeed": { "$ref": "#/$defs/nonNegative" },
        "diagnostics": { "type": "boolean" },
        "sleepSteps": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "minimumFloorSupportPoints": { "type": "integer", "minimum": 1, "maximum": 8 },
        "bounds": { "$ref": "#/$defs/bounds" },
        "scale": { "$ref": "#/$defs/scale" },
        "planes": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/plane" }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localPoint"],
      "properties": { "localPoint": { "$ref": "#/$defs/vec3" } }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "node", "bodyType", "shape"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "node": { "$ref": "#/$defs/id" },
        "bodyType": { "enum": ["static", "kinematic", "dynamic"] },
        "mass": { "$ref": "#/$defs/positive" },
        "initialState": { "enum": ["awake", "sleeping"] },
        "shape": { "$ref": "#/$defs/shape" },
        "colliderRelation": { "enum": ["match", "proxy"] },
        "transformSpace": { "enum": ["local", "world"] },
        "anchors": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/anchor" }
        },
        "linearDamping": { "type": "number", "minimum": 0 },
        "angularDamping": { "type": "number", "minimum": 0 },
        "gravityScale": { "type": "number" },
        "allowSleep": { "type": "boolean" },
        "isSleeping": { "type": "boolean" },
        "isTrigger": { "type": "boolean" },
        "fixedRotation": { "type": "boolean" },
        "collisionLayer": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "collisionMask": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "material": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "friction": { "type": "number", "minimum": 0 },
            "restitution": { "type": "number", "minimum": 0, "maximum": 1 },
            "linearDamping": { "type": "number", "minimum": 0 },
            "angularDamping": { "type": "number", "minimum": 0 }
          }
        }
      },
      "allOf": [{
        "if": { "properties": { "bodyType": { "const": "dynamic" } } },
        "then": { "required": ["mass"] }
      }]
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "body": { "$ref": "#/$defs/id" },
        "node": { "$ref": "#/$defs/id" },
        "anchor": { "$ref": "#/$defs/id" },
        "localPoint": { "$ref": "#/$defs/vec3" }
      },
      "oneOf": [
        { "required": ["body"] },
        { "required": ["node"] }
      ],
      "allOf": [
        {
          "oneOf": [
            { "required": ["anchor"] },
            { "required": ["localPoint"] }
          ]
        }
      ]
    },
    "distanceJoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "a", "b", "lengthMeters"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "const": "distance" },
        "a": { "$ref": "#/$defs/endpoint" },
        "b": { "$ref": "#/$defs/endpoint" },
        "lengthMeters": { "$ref": "#/$defs/positive" },
        "collideConnected": { "type": "boolean" },
        "compliance": { "type": "number", "minimum": 0 },
        "positionCorrectionSlop": { "type": "number", "minimum": 0 }
      }
    }
  }
}
